echo "SECRET_KEY=your_secret_key_here" > .env.example
echo "SENDGRID_FROM_EMAIL=your_email@example.com" >> .env.example
echo "ADMIN_EMAIL=admin@example.com" >> .env.example
echo "COMPANY_NAME=Your Company Name" >> .env.example
echo "MONGO_DB=your_db_name" >> .env.example
echo "DB_HOST=localhost" >> .env.example
echo "DB_PORT=27017" >> .env.example
echo "GCS_BUCKET_NAME=your_bucket_name" >> .env.example
echo "GCS_PROJECT_ID=your-project-id" >> .env.example
echo "GCS_CREDENTIALS_PATH=/path/to/your/credentials.json" >> .env.example